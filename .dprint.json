{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 120,
  "indentWidth": 2,
  "useTabs": false,
  "newLineKind": "lf",
  "excludes": [
    "**/node_modules",
    "**/*-lock.json",
    ".boilerplate-answers.yaml",
    ".updatecli/manifests/**",
    "CHANGELOG.md"
  ],
  "extends": [
    "https://raw.githubusercontent.com/aacebedo/boilerplate-templates/v0.3.3/static_files/dprint/container.json",
    "https://raw.githubusercontent.com/aacebedo/boilerplate-templates/v0.3.3/static_files/dprint/helmcharts.json",
    "https://raw.githubusercontent.com/aacebedo/boilerplate-templates/v0.3.3/static_files/dprint/base.json"
  ]
}
